    "from numpy.random import random\n",
    "from tdigest import TDigest\n",
    "\n",
    "digest = TDigest()\n",
    "for x in range(10000):\n",
    "    digest.update(random())\n",
    "\n",
    "print(digest.percentile(15))"
   ]
  }
